  "webhooks": {
    "transportEvent": {
      "post": {
        "operationId": "receiveTransportEvent",
        "summary": "Événements Transport → Market (11 types), signés ; Market répond 2xx après enregistrement idempotent (id unique).",
        "parameters": [
          {
            "name": "tamurt-signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reçu"
          },
          "401": {
            "description": "Signature invalide"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oauth": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "/oauth/token",
            "scopes": {
              "shipping:quote": "Devis",
              "shipping:reserve": "Réservations",
              "shipping:track": "Suivi"
            }
          }
        }
      }
    },
    "schemas": {
      "QuoteRequest": {
        "type": "object",
        "properties": {
          "partnerReference": {
            "type": "string",
            "maxLength": 80
          },
          "origin": {
            "type": "object",
            "properties": {
              "countryCode": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              "city": {
                "type": "string",
                "maxLength": 120
              },
              "regionCode": {
                "type": "string",
                "maxLength": 10
              }
            },
            "required": [
              "countryCode"
            ]
          },
          "destination": {
            "type": "object",
            "properties": {
              "countryCode": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              "city": {
                "type": "string",
                "maxLength": 120
              },
              "regionCode": {
                "type": "string",
                "maxLength": 10
              }
            },
            "required": [
              "countryCode"
            ]
          },
          "parcel": {
            "type": "object",
            "properties": {
              "weightGrams": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 30000
              },
              "sizeClass": {
                "type": "string",
                "enum": [
                  "XS",
                  "S",
                  "M",
                  "L",
                  "XL"
                ]
              },
              "declaredValue": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  }
                },
                "required": [
                  "amount",
                  "currency"
                ]
              },
              "categoryCode": {
                "type": "string",
                "maxLength": 80
              },
              "isFragile": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": [
              "weightGrams",
              "sizeClass",
              "declaredValue",
              "categoryCode"
            ]
          },
          "earliestDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "latestDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "origin",
          "destination",
          "parcel"
        ]
      },
      "ReservationRequest": {
        "type": "object",
        "properties": {
          "quoteId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "partnerOrderId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "holdMinutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 60
          }
        },
        "required": [
          "quoteId",
          "partnerOrderId",
          "holdMinutes"
        ]
      },
      "ConfirmReservationRequest": {
        "type": "object",
        "properties": {
          "partnerOrderId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "paymentReference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "sender": {
            "type": "object",
            "properties": {
              "displayName": {
                "type": "string",
                "maxLength": 120
              },
              "phone": {
                "type": "string",
                "maxLength": 32
              }
            },
            "required": [
              "displayName"
            ]
          },
          "recipient": {
            "type": "object",
            "properties": {
              "displayName": {
                "type": "string",
                "maxLength": 120
              },
              "phone": {
                "type": "string",
                "maxLength": 32
              },
              "city": {
                "type": "string",
                "maxLength": 120
              }
            },
            "required": [
              "displayName",
              "city"
            ]
          }
        },
        "required": [
          "partnerOrderId",
          "paymentReference",
          "sender",
          "recipient"
        ]
      },
      "CancelReservationRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "reason"
        ]
      },
      "IncidentRequest": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "DAMAGED",
              "LOST",
              "DELAY",
              "RECIPIENT_UNAVAILABLE",
              "OTHER"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 5,
            "maxLength": 2000
          }
        },
        "required": [
          "type",
          "description"
        ]
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "minLength": 20
          },
          "token_type": {
            "type": "string",
            "const": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 3600
          },
          "scope": {
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "scope"
        ],
        "additionalProperties": false
      },
      "QuoteResponse": {
        "type": "object",
        "properties": {
          "corridorStatus": {
            "type": "string",
            "enum": [
              "LIVE",
              "TEST_ONLY",
              "DISABLED"
            ]
          },
          "quotes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "quoteId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "expiresAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                },
                "corridor": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}-[A-Z]{2}$"
                },
                "service": {
                  "type": "string",
                  "const": "crowdshipping"
                },
                "price": {
                  "type": "object",
                  "properties": {
                    "amount": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "currency": {
                      "type": "string",
                      "pattern": "^[A-Z]{3}$"
                    }
                  },
                  "required": [
                    "amount",
                    "currency"
                  ],
                  "additionalProperties": false
                },
                "trip": {
                  "type": "object",
                  "properties": {
                    "departureDate": {
                      "type": "string",
