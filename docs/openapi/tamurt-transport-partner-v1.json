{
  "openapi": "3.1.0",
  "info": {
    "title": "Tamurt Transport — API partenaire (PROPOSITION de Tamurt Market)",
    "license": {
      "name": "Propriétaire — Tamurt Services",
      "identifier": "LicenseRef-Proprietary"
    },
    "version": "v1 (2026-11-01)",
    "description": "Contrat proposé par Tamurt Market ; Tamurt Transport ne l'implémente pas encore. Authentification OAuth 2.0 client credentials (portées shipping:quote, shipping:reserve, shipping:track), idempotence obligatoire sur les écritures, webhooks signés HMAC-SHA256 (en-tête tamurt-signature : t=<timestamp>,v1=<hex>)."
  },
  "servers": [
    {
      "url": "{baseUrl}",
      "variables": {
        "baseUrl": {
          "default": "https://transport.example.invalid/partner/v1",
          "description": "[À DÉFINIR par l'équipe Tamurt Transport]"
        }
      }
    }
  ],
  "security": [
    {
      "oauth": []
    }
  ],
  "paths": {
    "/oauth/token": {
      "post": {
        "security": [],
        "operationId": "issueToken",
        "summary": "Obtenir un jeton de service (client credentials)",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "grant_type": {
                    "const": "client_credentials"
                  },
                  "client_id": {
                    "type": "string"
                  },
                  "client_secret": {
                    "type": "string"
                  },
                  "scope": {
                    "type": "string"
                  }
                },
                "required": [
                  "grant_type",
                  "client_id",
                  "client_secret"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Jeton (durée ≤ 1 h)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Erreur 400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransportError"
                }
              }
            }
          },
          "401": {
            "description": "Erreur 401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransportError"
                }
              }
            }
          }
        }
      }
    },
