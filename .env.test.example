# ─────────────────────────────────────────────────────────────────────────────
# Tamurt Market — variables d'environnement de TEST (valeurs factices, sans valeur en production)
# Copier en .env (développement) ; ne JAMAIS versionner de vrais secrets.
# Générer un secret : openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# Base de données PostgreSQL 16+ (extensions requises : unaccent, pg_trgm, citext)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tamurt_market_test?schema=public"

# URL publique de l'application
APP_URL="http://localhost:3000"

# Authentification (Better Auth) — 32 caractères minimum
BETTER_AUTH_SECRET="test-only-auth-secret-0123456789abcdef0123456789abcdef"
# BETTER_AUTH_URL="http://localhost:3000"

# Secret des appels cron (/api/cron/*), en-tête Authorization: Bearer <CRON_SECRET>
CRON_SECRET="test-only-cron-secret-0123"

# Poivre HMAC des codes à usage unique (remise en main propre)
CODE_PEPPER="test-only-code-pepper-0123"

# Connexion Google (facultatif) — URI de redirection : <APP_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Emails transactionnels : outbox (aucun envoi réel, visibles sur /dev/boite-mail) | resend
EMAIL_PROVIDER="outbox"
# RESEND_API_KEY=""
EMAIL_FROM="Tamurt Market <no-reply@localhost>"

# Paiement : sandbox (simulateur local, interdit en production) | none (achat intégré désactivé)
PAYMENT_PROVIDER="sandbox"
PAYMENT_SANDBOX_WEBHOOK_SECRET="dev-only-payment-sandbox-secret-change-me"

# Livraison nationale : sandbox (simulateur local, interdit en production) | none
SHIPPING_PROVIDER="sandbox"
SHIPPING_SANDBOX_WEBHOOK_SECRET="dev-only-shipping-sandbox-secret-change-me"

# Tamurt Transport : disabled | simulator (contrat v1 simulé localement) | remote (API réelle, non disponible)
TRANSPORT_INTEGRATION="simulator"
TRANSPORT_WEBHOOK_SECRET="dev-only-transport-webhook-secret-change-me"
# TRANSPORT_API_BASE_URL="https://transport.example.com/api/partner/v1"
# TRANSPORT_CLIENT_ID=""
# TRANSPORT_CLIENT_SECRET=""
TRANSPORT_TIMEOUT_MS=4000

# Stockage des fichiers : local | s3 (S3 compatible : AWS, Cloudflare R2, Supabase Storage, Scaleway…)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage-test"
# S3_ENDPOINT=""
# S3_REGION="auto"
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Double authentification obligatoire pour /admin (toujours active en production)
ADMIN_REQUIRE_2FA="false"

LOG_LEVEL="info"
# SENTRY_DSN=""   # réservé, SDK non intégré (voir docs/ROADMAP.md)
